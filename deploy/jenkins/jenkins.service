# Jenkins controller for media-workspace.
#
# Two settings are deliberate rather than default:
#   * the controller is bound to loopback. It is an administrative interface; exposing it would put
#     arbitrary code execution one login away from the internet. Reach it through an SSH tunnel.
#   * it runs on JDK 21 while the project compiles with JDK 17. Jenkins' own requirements and the
#     application's are separate, and the delivery contract says not to assume they can share one.
#
# The heap is capped at 320 MiB: the controller holds schedules, not builds. Executors are set to
# zero in the configuration so no build runs here at all.

[Unit]
Description=Jenkins controller (media-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=JENKINS_HOME=/opt/jenkins
# The initialisation scripts read the administrator password, the agent name and the agent's secret
# path from the environment. Without this the realm is left unconfigured, which the controller
# reports and then refuses to serve - correctly, since the alternative is an unauthenticated
# administrative endpoint.
EnvironmentFile=/opt/media-workspace/config/media-workspace.env
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# The update site is deliberately NOT set here. JENKINS_UC and JENKINS_UC_DOWNLOAD were read by
# older Jenkins releases; neither string occurs anywhere in jenkins-core 2.568.3, so setting them
# had no effect on which site the controller used. The site that is actually consulted is the one
# recorded in $JENKINS_HOME/hudson.model.UpdateCenter.xml, left at its default. Plugins are
# installed from scripts/setup-jenkins.sh.
# The temporary directory is moved out of /tmp on purpose. Jenkins' DiskSpaceMonitor takes a node
# offline when the filesystem holding its temporary directory has less than 1 GiB free, and on this
# host /tmp is a 981 MiB tmpfs. The controller was therefore marked offline on every start with
# "Disk space is below threshold of 1.00 GiB. Only 896.79 MiB out of 981.25 MiB left on /tmp", and
# the same monitor would take the agent offline as well. $JENKINS_HOME/tmp is on the 59 GiB root
# filesystem. The directory is created by scripts/setup-jenkins.sh.
# This job intentionally checks out the trusted local repository at /home/ubuntu/media-workspace's source
# checkout. GitSCM rejects local remotes by default; enable the explicit local-checkout exception in
# the controller too because SCM configuration and checkout orchestration can run in either JVM.
Environment="JAVA_OPTS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -Dfile.encoding=UTF-8 -Duser.timezone=UTC -Djava.io.tmpdir=/opt/jenkins/tmp -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true"
# The listen address and port are arguments rather than CLI options on the unit, so the bind is
# visible next to the reason it is loopback-only.
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java $JAVA_OPTS -jar /opt/jenkins/jenkins.war --httpListenAddress=127.0.0.1 --httpPort=8081 --prefix=
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target

# Jenkins inbound build agent for media-workspace.
#
# An inbound agent: it dials the controller, so no port is opened here for builds and the controller
# holds no credential for reaching this machine. Separate user, separate working directory and
# separate JVM options from the controller, as the delivery contract requires even when both run on
# one host.
#
# The agent itself runs on JDK 21, which is required by Jenkins 2.568.3. The build exports JDK 17
# through the node environment for the application toolchain, and Node for the front end; the
# runtime environment file lets the integration stage reach MySQL and Kafka without any credential
# appearing in a command line.

[Unit]
Description=Jenkins inbound agent (media-workspace)
After=network-online.target media-jenkins.service
Wants=network-online.target
Requires=media-jenkins.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/jenkins-agent
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
EnvironmentFile=/opt/media-workspace/config/media-workspace.env
Environment=MW_ENV_FILE=/opt/media-workspace/config/media-workspace.env
Environment=DEPLOY_ROOT=/opt/media-workspace
# The secret is read from a file written by the controller's own initialisation, so it never appears
# in this unit, in a command line or in the repository.
#
# -webSocket is required, not optional. The controller opens no TCP agent port - its configuration
# sets slaveAgentPort to -1 - so the only endpoint an agent can reach is the WebSocket one on the
# controller's HTTP port. Without this flag the agent tries the TCP protocol, finds nothing
# listening and retries until the unit is restarted.
# The temporary directory is moved out of /tmp for the same reason as the controller: /tmp is a
# 981 MiB tmpfs, which is below the 1 GiB threshold of Jenkins' DiskSpaceMonitor, and an agent the
# monitor marks offline never accepts a build. /opt/jenkins-agent/tmp is on the root filesystem.
ExecStart=/bin/bash -c 'exec "$JAVA_HOME/bin/java" -Xms64m -Xmx256m -XX:+UseSerialGC \
  -Dfile.encoding=UTF-8 -Duser.timezone=UTC \
  -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true \
  -Djava.io.tmpdir=/opt/jenkins-agent/tmp \
  -jar /opt/jenkins-agent/agent.jar \
  -url http://127.0.0.1:8081/ \
  -secret @/opt/jenkins/agent.secret \
  -name media-workspace-agent \
  -webSocket \
  -workDir /opt/jenkins-agent'
Restart=on-failure
RestartSec=15
SuccessExitStatus=143
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target

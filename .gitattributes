# Line endings are part of the artifact for some files.
#
# A shell script whose shebang ends with CR fails with "env: 'bash\r': No such file or directory",
# which looks like a missing interpreter rather than a line-ending problem. Git is told to store and
# check out these files with LF on every platform.
* text=auto eol=lf

*.sh            text eol=lf
gradlew         text eol=lf
*.bash          text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.sql           text eol=lf
*.java          text eol=lf
*.gradle        text eol=lf
*.md            text eol=lf
*.feature       text eol=lf

# Binaries must never be touched.
*.jar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.mp4           binary
*.tgz           binary
*.zip           binary
